; Example authoritative zone (BIND9 master file format)
$TTL 3600
$ORIGIN example.com.
@   IN  SOA ns1.example.com. hostmaster.example.com. (
        2024010101 ; serial
        1h         ; refresh
        15m        ; retry
        1w         ; expire
        5m )       ; minimum
    IN  NS  ns1.example.com.
    IN  NS  ns2.example.com.
    IN  MX  10 mail.example.com.
    IN  TXT "v=spf1 mx -all"
ns1     IN A    192.0.2.53
ns2     IN A    192.0.2.54
mail    IN A    192.0.2.25
www     IN A    192.0.2.1
        IN AAAA 2001:db8::1
        IN TXT  "hello" "world"
alias   IN CNAME www
*.wild  IN A    192.0.2.99
sub     IN NS   ns.sub.example.com.
ns.sub  IN A    192.0.2.100
_sip._tcp IN SRV 10 60 5060 sip.example.com.
sip     IN A    192.0.2.30
caa     IN CAA  0 issue "letsencrypt.org"
loc     IN LOC  42 21 54 N 71 06 18 W -24m 30m
*.cn    IN CNAME www
